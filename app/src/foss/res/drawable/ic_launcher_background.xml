<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Southwest-to-Northeast, true 45-degree diagonal: dark holds through
         the lower-left (where the legacy/Play Store composite's G and I
         letters sit) and only lightens in the upper-right quadrant, past
         where the panda's right eye sits. The foss flavor's green version of the main
         blue gradient (same shape, hue turned to green). -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="108"
                android:endX="108"
                android:endY="0"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0B361C" />
                <item android:offset="0.55" android:color="#FF1DD869" />
                <item android:offset="0.75" android:color="#FF3DF838" />
                <item android:offset="1.0" android:color="#FFEAFFEC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
