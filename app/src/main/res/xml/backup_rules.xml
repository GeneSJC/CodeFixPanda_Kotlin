<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The user-entered GitHub token stays on this device: never copied
         into backups. Keep this file name in sync with PREFS_NAME in
         data/ApiTokenRepository.kt. -->
    <exclude domain="sharedpref" path="api_token_prefs.xml"/>
    <!-- The ad-free period stays on this device too. Keep in sync with PREFS_NAME in ads/AdFreePeriod.kt. -->
    <exclude domain="sharedpref" path="ad_free_prefs.xml"/>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>